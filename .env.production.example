# ==========================================================================
# CLS (Central License Server) — Production Environment Variables (.env)
# ==========================================================================
# Copy file ini ke .env dan sesuaikan nilai-nilainya.
# JANGAN commit file .env ke repository!
# ==========================================================================

# --- Core Django ---
DEBUG=False
DJANGO_ENVIRONMENT=production
SECRET_KEY=GANTI_DENGAN_RANDOM_KEY_50_KARAKTER

# --- Domain & Hosts ---
ALLOWED_HOSTS=cls.serpgroup.cloud
CSRF_TRUSTED_ORIGINS=https://cls.serpgroup.cloud
BASE_URL=https://cls.serpgroup.cloud

# --- Identitas CLS ---
IS_LICENSE_SERVER=True

# ==========================================================================
# SaaS Server Connections — Multi-Software Tenant Management
# ==========================================================================
# CLS berkomunikasi ke masing-masing software server via DOMAIN (bukan port).
# Subdomain wildcard (*) digunakan untuk tenant routing.
# ==========================================================================

# SIMS Server
SIMS_SERVER_URL=https://sims.serpgroup.cloud
SIMS_INTERNAL_API_KEY=GANTI_DENGAN_SIMS_API_KEY

# SIMKOS Server
SIMKOS_SERVER_URL=https://simkos.serpgroup.cloud
SIMKOS_INTERNAL_API_KEY=GANTI_DENGAN_SIMKOS_API_KEY

# SERPTECH Server
SERPTECH_SERVER_URL=https://serptech.serpgroup.cloud
SERPTECH_INTERNAL_API_KEY=GANTI_DENGAN_SERPTECH_API_KEY

# --- Tenant Domain Configuration ---

# Suffix domain untuk auto-generate saat buat tenant baru.
# Di form CLS, domain tenant otomatis jadi: {nama-perusahaan}{suffix}
# Dev: .localhost  |  Production: .serpgroup.cloud
TENANT_DOMAIN_SUFFIX=.serpgroup.cloud
