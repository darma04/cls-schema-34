# =============================================================================
#  Central License Server (Isolated Schema) — Production Environment
# =============================================================================
#  Copy file ini ke .env.prod lalu isi dengan nilai yang benar:
#    cp .env.prod.example .env.prod
# =============================================================================

# -- Django Settings --
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=False
ALLOWED_HOSTS=cls.your-domain.com,server-ip
CSRF_TRUSTED_ORIGINS=https://cls.your-domain.com
DJANGO_ENVIRONMENT=production
BASE_URL=https://cls.your-domain.com

# -- License Server (self-reference) --
IS_LICENSE_SERVER=True

# -- Database (PostgreSQL) --
DB_ENGINE=postgresql
DB_NAME=cls_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=600

# -- Redis Cache --
CACHE_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/1

# -- Email (SMTP) --
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# -- Sentry Error Monitoring (optional) --
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.1
